# MongoDB Atlas connection string. The connecting machine's IP must be
# whitelisted in Atlas or connections fail with ENOTFOUND.
MONGODB_URI=

# Random secret used to sign NextAuth JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Base URL of this deployment (used by NextAuth callbacks, robots.txt, sitemap.xml).
NEXTAUTH_URL=http://localhost:3000

# Optional. Without it, AI categorization/matching falls back to a keyword-based
# mock — this is the normal/expected dev mode. Get a free-tier key (no billing
# required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for image uploads (request photos, avatars). Get a free-tier token
# from your app's dashboard at https://uploadthing.com — API Keys page, "v7" token.
UPLOADTHING_TOKEN=
